---
import '../styles/global.css';
import type { Content } from '../i18n/content';
import { withBase } from '../i18n/content';
import Header from '../components/Header.astro';

type Props = {
  content: Content;
};

const { content } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const skipLabel = content.locale === 'fr' ? 'Aller au contenu' : 'Skip to content';
---

<!doctype html>
<html lang={content.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={content.meta.description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0F172A" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{content.meta.title}</title>
  </head>
  <body>
    <a class="skip" href="#main">{skipLabel}</a>
    <div class="site">
      <Header content={content} />
      <main id="main">
        <slot />
      </main>
      <footer class="footer">
        <div class="wrap footer__inner">
          <p translate="no">{content.footer.rights}</p>
          <p class="footer__loc">{content.about.location}</p>
        </div>
      </footer>
    </div>
    <script>
      const reveal = () => {
        const nodes = document.querySelectorAll('.reveal');
        const ledger = document.querySelector('[data-ledger]');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          nodes.forEach((n) => n.classList.add('is-visible'));
          ledger?.classList.add('is-drawn');
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
        );
        nodes.forEach((n) => io.observe(n));

        if (ledger) {
          const ruleIo = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  ledger.classList.add('is-drawn');
                  ruleIo.disconnect();
                }
              });
            },
            { threshold: 0.05 },
          );
          ruleIo.observe(ledger);
        }
      };
      reveal();
    </script>
  </body>
</html>

<style>
  .footer {
    padding: 2.25rem 0 3rem;
    color: var(--muted);
    font-size: 0.875rem;
    background: var(--surface);
    border-top: var(--hairline);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
  }

  .footer__loc {
    color: var(--ink);
    font-weight: 500;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  @media (min-width: 860px) {
    .footer .wrap {
      padding-left: 1.85rem;
    }
  }
</style>
