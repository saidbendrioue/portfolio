---
import type { Content } from '../i18n/content';

type Props = { content: Content };
const { content } = Astro.props;
---

<section id="skills" class="section section--alt skills">
  <div class="wrap">
    <div class="reveal">
      <p class="section__eyebrow">03</p>
      <h2 class="section__title">{content.skills.title}</h2>
      <p class="section__lead">{content.skills.lead}</p>
    </div>

    <div class="skills__grid">
      {
        content.skills.groups.map((group) => (
          <div class="skill reveal">
            <h3>{group.label}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills__grid {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.75rem 2rem;
  }

  .skill h3 {
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    margin-bottom: 0.65rem;
  }

  .skill ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skill li {
    color: var(--ink-secondary);
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
    padding: 0.3rem 0.65rem;
    border-radius: 980px;
    background: var(--fill);
  }

  @media (min-width: 760px) {
    .skills__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1020px) {
    .skills__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
