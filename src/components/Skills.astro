---
import type { Content } from '../i18n/content';

type Props = { content: Content };
const { content } = Astro.props;
---

<section id="skills" class="section section--alt skills">
  <div class="wrap">
    <div class="reveal">
      <h2 class="section__title">{content.skills.title}</h2>
      <p class="section__lead">{content.skills.lead}</p>
    </div>

    <dl class="skills__list">
      {
        content.skills.groups.map((group) => (
          <div class="skill reveal">
            <dt>{group.label}</dt>
            <dd>{group.items.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .skills__list {
    margin-top: 2.25rem;
    display: grid;
    gap: 0;
    border-top: var(--hairline);
  }

  .skill {
    display: grid;
    gap: 0.35rem;
    padding: 1.15rem 0;
    border-bottom: var(--hairline);
  }

  .skill dt {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .skill dd {
    margin: 0;
    color: var(--ink);
    font-size: 1.02rem;
    line-height: 1.5;
    font-weight: 500;
  }

  @media (min-width: 860px) {
    .skill {
      grid-template-columns: 11rem 1fr;
      gap: 1.5rem;
      align-items: baseline;
    }
  }
</style>
