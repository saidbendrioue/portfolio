---
import type { Content } from '../i18n/content';

type Props = { content: Content };
const { content } = Astro.props;
---

<section id="projects" class="section projects">
  <div class="wrap">
    <div class="reveal projects__intro">
      <p class="section__eyebrow">02</p>
      <h2 class="section__title">{content.projects.title}</h2>
      <p class="section__lead">{content.projects.lead}</p>
    </div>

    <ol class="projects__list">
      {
        content.projects.items.map((project, index) => (
          <li class="project reveal" style={`--delay: ${index * 40}ms`}>
            <div class="project__meta">
              <span class="project__index">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <p class="project__client">{project.client}</p>
                <p class="project__role">
                  {project.role} · {project.period}
                </p>
              </div>
            </div>
            <h3 class="project__title">{project.title}</h3>
            <p class="project__summary">{project.summary}</p>
            <ul class="project__stack">
              {project.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <aside class="also reveal">
      <h3 class="also__title">{content.projects.also.title}</h3>
      <ul class="also__list">
        {content.projects.also.items.map((item) => <li>{item}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .projects__intro {
    margin-bottom: 2.75rem;
  }

  .projects__list {
    display: grid;
    border-top: var(--hairline);
  }

  .project {
    display: grid;
    gap: 0.7rem;
    padding: 1.85rem 0;
    border-bottom: var(--hairline);
    transition-delay: var(--delay, 0ms);
  }

  .project__meta {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .project__index {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    min-width: 1.5rem;
    letter-spacing: 0.02em;
    padding-top: 0.15rem;
  }

  .project__client {
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .project__role {
    color: var(--ink-secondary);
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
  }

  .project__title {
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .project__summary {
    color: var(--ink-secondary);
    max-width: 58rem;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.15rem;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .project__stack li {
    padding: 0.2rem 0.55rem;
    border-radius: 980px;
    background: var(--fill);
  }

  .also {
    margin-top: 2.75rem;
    padding: 1.5rem 1.35rem;
    border-radius: 1.1rem;
    background: var(--surface);
    box-shadow:
      0 0.5px 0 rgba(255, 255, 255, 0.7) inset,
      0 8px 28px rgba(0, 0, 0, 0.04);
  }

  .also__title {
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    margin-bottom: 0.85rem;
  }

  .also__list {
    display: grid;
    gap: 0.7rem;
    color: var(--ink-secondary);
    font-size: 1rem;
    line-height: 1.45;
  }

  .also__list li {
    padding-left: 0.95rem;
    position: relative;
  }

  .also__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
