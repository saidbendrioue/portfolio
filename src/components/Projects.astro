---
import type { Content } from '../i18n/content';

type Props = { content: Content };
const { content } = Astro.props;
---

<section id="projects" class="section projects">
  <div class="wrap">
    <div class="reveal projects__intro">
      <h2 class="section__title">{content.projects.title}</h2>
      <p class="section__lead">{content.projects.lead}</p>
    </div>

    <ol class="projects__list">
      {
        content.projects.items.map((project, index) => (
          <li class="project reveal">
            <div class="project__meta">
              <span class="project__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <p class="project__client">{project.client}</p>
                <p class="project__role">
                  {project.role} · {project.period}
                </p>
              </div>
            </div>
            <h3 class="project__title">{project.title}</h3>
            <p class="project__summary">{project.summary}</p>
            <p class="project__stack">{project.stack.join(' · ')}</p>
          </li>
        ))
      }
    </ol>

    <aside class="also reveal">
      <h3 class="also__title">{content.projects.also.title}</h3>
      <ul class="also__list">
        {content.projects.also.items.map((item) => <li>{item}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .projects__intro {
    margin-bottom: 2.5rem;
  }

  .projects__list {
    list-style: none;
    border-top: var(--hairline);
  }

  .project {
    display: grid;
    gap: 0.65rem;
    padding: 1.85rem 0;
    border-bottom: var(--hairline);
  }

  .project__meta {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .project__index {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    min-width: 1.5rem;
    padding-top: 0.1rem;
  }

  .project__client {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .project__role {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .project__title {
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .project__summary {
    color: var(--muted);
    max-width: 58rem;
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .project__stack {
    color: var(--ink-soft);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .also {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line);
  }

  .also__title {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
  }

  .also__list {
    display: grid;
    gap: 0.6rem;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .also__list li {
    padding-left: 0.9rem;
    position: relative;
  }

  .also__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.35rem;
    height: 0.35rem;
    background: var(--ink);
  }
</style>
