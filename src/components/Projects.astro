---
import type { Content } from '../i18n/content';

type Props = { content: Content };
const { content } = Astro.props;
---

<section id="projects" class="section projects">
  <div class="wrap">
    <div class="reveal projects__intro">
      <h2 class="section__title">{content.projects.title}</h2>
      <p class="section__lead">{content.projects.lead}</p>
    </div>

    <ol class="projects__list">
      {
        content.projects.items.map((project) => (
          <li class="project reveal">
            <div class="project__head">
              <p class="project__client">{project.client}</p>
              <p class="project__role">
                <span>{project.role}</span>
                <span class="project__sep" aria-hidden="true">·</span>
                <span class="project__period">{project.period}</span>
              </p>
            </div>
            <h3 class="project__title">{project.title}</h3>
            <p class="project__summary">{project.summary}</p>
            <p class="project__stack">{project.stack.join(' · ')}</p>
          </li>
        ))
      }
    </ol>

    <aside class="also reveal">
      <h3 class="also__title">{content.projects.also.title}</h3>
      <ul class="also__list">
        {content.projects.also.items.map((item) => <li>{item}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .projects__intro {
    margin-bottom: 2.75rem;
  }

  .projects__list {
    list-style: none;
    border-top: var(--hairline);
  }

  .project {
    display: grid;
    gap: 0.7rem;
    padding: 1.9rem 0.5rem 1.9rem 0;
    border-bottom: var(--hairline);
    transition: background-color 0.2s var(--ease);
  }

  .project:hover {
    background: var(--fill);
  }

  .project__client {
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: 1.02rem;
  }

  .project__role {
    color: var(--muted);
    font-size: 0.875rem;
    font-family: var(--font-mono);
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.45rem;
    margin-top: 0.2rem;
  }

  .project__sep {
    opacity: 0.55;
  }

  .project__title {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
    margin-top: 0.15rem;
  }

  .project__summary {
    color: var(--muted);
    max-width: 60ch;
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .project__stack {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.45;
    max-width: 72ch;
  }

  .also {
    margin-top: 2.75rem;
    padding-top: 1.6rem;
    border-top: 1px dashed var(--color-border);
  }

  .also__title {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.85rem;
  }

  .also__list {
    display: grid;
    gap: 0.7rem;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.45;
    max-width: 60ch;
  }

  .also__list li {
    padding-left: 0.95rem;
    position: relative;
  }

  .also__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.35rem;
    height: 0.35rem;
    background: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .project {
      transition: none;
    }
  }
</style>
