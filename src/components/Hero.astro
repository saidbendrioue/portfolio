---
import { Image } from 'astro:assets';
import type { Content } from '../i18n/content';
import { withBase, localizeHref } from '../i18n/content';
import portrait from '../assets/said-bendrioue.jpg';

type Props = { content: Content };
const { content } = Astro.props;
---

<section class="hero" aria-label="Hero">
  <div class="hero__media">
    <Image
      src={portrait}
      alt={content.hero.photoAlt}
      widths={[720, 1080, 1600, 2200]}
      sizes="100vw"
      quality={82}
      class="hero__img"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__shade" aria-hidden="true"></div>
  </div>

  <div class="hero__content hero__anim">
    <p class="hero__role">{content.hero.role}</p>
    <h1 class="hero__brand">{content.hero.brand}</h1>
    <p class="hero__headline">{content.hero.headline}</p>
    <p class="hero__lead">{content.hero.lead}</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href={localizeHref(content.locale, '#contact')}>{content.hero.ctaPrimary}</a>
      <a class="btn btn--ghost" href={withBase('cv-said-bendrioue.pdf')} download>{content.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    color: var(--white);
    overflow: clip;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg, rgba(10, 35, 66, 0.88) 0%, rgba(10, 35, 66, 0.55) 42%, rgba(10, 35, 66, 0.22) 100%),
      linear-gradient(180deg, rgba(10, 35, 66, 0.35) 0%, rgba(10, 35, 66, 0.12) 38%, rgba(10, 35, 66, 0.86) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: min(100% - 2.5rem, 42rem);
    margin-left: max(1.25rem, calc((100% - var(--max)) / 2));
    margin-right: auto;
    padding: 7.25rem 0 4.5rem;
  }

  .hero__role {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 0.9rem;
  }

  .hero__brand {
    font-family: var(--font-display);
    font-size: clamp(2.85rem, 9vw, 5.1rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.98;
    margin-bottom: 1rem;
    color: var(--white);
  }

  .hero__headline {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.22;
    max-width: 20ch;
    margin-bottom: 0.85rem;
    color: rgba(255, 255, 255, 0.96);
  }

  .hero__lead {
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.0625rem;
    line-height: 1.5;
    margin-bottom: 1.85rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  /* One settle — no staggered child delays */
  .hero__anim {
    opacity: 0;
    animation: heroIn 0.45s var(--ease) 60ms forwards;
  }

  @keyframes heroIn {
    to {
      opacity: 1;
    }
  }

  @media (max-width: 720px) {
    .hero__content {
      padding-top: 6.25rem;
      padding-bottom: 3rem;
    }

    .hero__img {
      object-position: center 12%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__anim {
      opacity: 1;
      animation: none;
    }
  }
</style>
