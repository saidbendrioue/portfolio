---
import { Image } from 'astro:assets';
import type { Content } from '../i18n/content';
import { withBase, localizeHref } from '../i18n/content';
import portrait from '../assets/said-bendrioue.jpg';

type Props = { content: Content };
const { content } = Astro.props;
---

<section class="hero" aria-label="Hero">
  <div class="hero__media">
    <Image
      src={portrait}
      alt={content.hero.photoAlt}
      widths={[720, 1080, 1600, 2200]}
      sizes="100vw"
      quality={82}
      class="hero__img"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__grid" aria-hidden="true"></div>
  </div>

  <div class="hero__content hero__anim">
    <h1 class="hero__brand" translate="no">{content.hero.brand}</h1>
    <p class="hero__role">{content.hero.role}</p>
    <p class="hero__headline">{content.hero.headline}</p>
    <p class="hero__lead">{content.hero.lead}</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href={localizeHref(content.locale, '#contact')}>{content.hero.ctaPrimary}</a>
      <a class="btn btn--ghost" href={withBase('cv-said-bendrioue.pdf')} download>{content.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: grid;
    align-items: end;
    color: var(--white);
    overflow: clip;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        108deg,
        color-mix(in srgb, #0f172a 94%, transparent) 0%,
        color-mix(in srgb, #0f172a 62%, transparent) 42%,
        color-mix(in srgb, #0f172a 22%, transparent) 100%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, #0f172a 42%, transparent) 0%,
        color-mix(in srgb, #0f172a 12%, transparent) 36%,
        color-mix(in srgb, #0f172a 92%, transparent) 100%
      );
  }

  /* Swiss construction marks — structure as ornament */
  .hero__grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(color-mix(in srgb, #fff 8%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, #fff 8%, transparent) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: linear-gradient(180deg, transparent 0%, #000 35%, #000 70%, transparent 100%);
    opacity: 0.35;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: min(100% - 2.5rem, 42rem);
    margin-left: max(1.25rem, calc((100% - var(--max)) / 2));
    margin-right: auto;
    padding: 7.5rem 0 4.75rem;
  }

  @media (min-width: 860px) {
    .hero__content {
      padding-left: 1.85rem;
    }
  }

  .hero__brand {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 9vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.98;
    margin-bottom: 0.85rem;
    color: var(--white);
  }

  .hero__role {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: color-mix(in srgb, #fff 72%, transparent);
    margin-bottom: 1.15rem;
  }

  .hero__headline {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.3vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
    max-width: 22ch;
    margin-bottom: 0.9rem;
    color: color-mix(in srgb, #fff 96%, transparent);
  }

  .hero__lead {
    max-width: 58ch;
    color: color-mix(in srgb, #fff 80%, transparent);
    font-size: 1.0625rem;
    line-height: 1.5;
    margin-bottom: 1.9rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .hero__anim {
    opacity: 0;
    transform: translateY(12px);
    animation: heroIn 0.45s var(--ease) 40ms forwards;
  }

  @keyframes heroIn {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .hero__content {
      padding-top: 6.5rem;
      padding-bottom: 3.25rem;
    }

    .hero__img {
      object-position: center 12%;
    }

    .hero__grid {
      opacity: 0.18;
      background-size: 48px 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__anim {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
