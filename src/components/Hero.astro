---
import { Image } from 'astro:assets';
import type { Content } from '../i18n/content';
import { withBase, localizeHref } from '../i18n/content';
import portrait from '../assets/said-bendrioue.jpg';

type Props = { content: Content };
const { content } = Astro.props;
---

<section class="hero" aria-label="Hero">
  <div class="hero__media">
    <Image
      src={portrait}
      alt={content.hero.photoAlt}
      widths={[720, 1080, 1600, 2200]}
      sizes="100vw"
      quality={82}
      class="hero__img"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__shade" aria-hidden="true"></div>
  </div>

  <div class="hero__content">
    <p class="hero__role hero__anim">{content.hero.role}</p>
    <h1 class="hero__brand hero__anim">{content.hero.brand}</h1>
    <p class="hero__headline hero__anim">{content.hero.headline}</p>
    <p class="hero__lead hero__anim">{content.hero.lead}</p>
    <div class="hero__cta hero__anim">
      <a class="btn btn--primary" href={localizeHref(content.locale, '#contact')}>{content.hero.ctaPrimary}</a>
      <a class="btn btn--ghost" href={withBase('cv-said-bendrioue.pdf')} download>{content.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    color: var(--white);
    overflow: clip;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    /* Static photo — no looping viewport motion (apple-design §14) */
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(8, 16, 28, 0.78) 0%, rgba(8, 16, 28, 0.4) 48%, rgba(8, 16, 28, 0.18) 100%),
      linear-gradient(180deg, rgba(8, 16, 28, 0.28) 0%, rgba(8, 16, 28, 0.08) 40%, rgba(8, 16, 28, 0.82) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: min(100% - 2.5rem, 40rem);
    margin-left: max(1.25rem, calc((100% - var(--max)) / 2));
    margin-right: auto;
    padding: 7.5rem 0 4.25rem;
  }

  .hero__role {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 0.85rem;
  }

  .hero__brand {
    font-size: clamp(2.75rem, 9vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin-bottom: 0.9rem;
    color: var(--white);
  }

  .hero__headline {
    font-size: clamp(1.25rem, 2.4vw, 1.65rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    max-width: 18ch;
    margin-bottom: 0.75rem;
    color: rgba(255, 255, 255, 0.96);
  }

  .hero__lead {
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.125rem;
    line-height: 1.45;
    letter-spacing: 0.01em;
    margin-bottom: 1.75rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  /* Entrance: short critically-damped rise, then settle — no continuous motion */
  .hero__anim {
    opacity: 0;
    transform: translate3d(0, 14px, 0);
    animation: heroIn 0.55s var(--spring) forwards;
  }

  .hero__anim:nth-child(1) {
    animation-delay: 40ms;
  }
  .hero__anim:nth-child(2) {
    animation-delay: 90ms;
  }
  .hero__anim:nth-child(3) {
    animation-delay: 140ms;
  }
  .hero__anim:nth-child(4) {
    animation-delay: 190ms;
  }
  .hero__anim:nth-child(5) {
    animation-delay: 240ms;
  }

  @keyframes heroIn {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .hero__content {
      padding-top: 6.5rem;
      padding-bottom: 3rem;
    }

    .hero__img {
      object-position: center 12%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__anim {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
