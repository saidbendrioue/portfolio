---
import { Image } from 'astro:assets';
import type { Content } from '../i18n/content';
import { withBase, localizeHref } from '../i18n/content';
import portrait from '../assets/said-bendrioue.jpg';

type Props = { content: Content };
const { content } = Astro.props;
---

<section class="hero" aria-label="Hero">
  <div class="hero__media" aria-hidden="false">
    <Image
      src={portrait}
      alt={content.hero.photoAlt}
      widths={[720, 1080, 1600, 2200]}
      sizes="100vw"
      quality={82}
      class="hero__img"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__shade"></div>
  </div>

  <div class="wrap hero__content">
    <p class="hero__role">{content.hero.role}</p>
    <h1 class="hero__brand">{content.hero.brand}</h1>
    <p class="hero__headline">{content.hero.headline}</p>
    <p class="hero__lead">{content.hero.lead}</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href={localizeHref(content.locale, '#contact')}>{content.hero.ctaPrimary}</a>
      <a class="btn btn--ghost" href={withBase('cv-said-bendrioue.pdf')} download>{content.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    color: var(--white);
    overflow: clip;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    transform: scale(1.04);
    animation: heroZoom 12s var(--ease) both;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(6, 18, 36, 0.82) 0%, rgba(6, 18, 36, 0.55) 42%, rgba(6, 18, 36, 0.28) 100%),
      linear-gradient(180deg, rgba(6, 18, 36, 0.35) 0%, rgba(6, 18, 36, 0.15) 35%, rgba(6, 18, 36, 0.78) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding: 8.5rem 0 4.5rem;
    max-width: 42rem;
    margin-left: max(1rem, calc((100% - var(--max)) / 2));
    margin-right: auto;
    width: min(100% - 2rem, 42rem);
  }

  .hero__role {
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 0.85rem;
    animation: rise 800ms var(--ease) both;
  }

  .hero__brand {
    font-size: clamp(2.8rem, 8vw, 5.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin-bottom: 1.1rem;
    animation: rise 900ms var(--ease) 80ms both;
  }

  .hero__headline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.7rem);
    font-weight: 600;
    max-width: 22ch;
    margin-bottom: 0.85rem;
    animation: rise 900ms var(--ease) 140ms both;
  }

  .hero__lead {
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.86);
    font-size: 1.08rem;
    margin-bottom: 1.75rem;
    animation: rise 900ms var(--ease) 200ms both;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    animation: rise 900ms var(--ease) 280ms both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes heroZoom {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1.02);
    }
  }

  @media (max-width: 720px) {
    .hero__content {
      padding-top: 7rem;
      padding-bottom: 3.25rem;
    }

    .hero__img {
      object-position: center 12%;
    }
  }
</style>
