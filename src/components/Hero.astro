---
import { Image } from 'astro:assets';
import type { Content } from '../i18n/content';
import { withBase, localizeHref } from '../i18n/content';
import portrait from '../assets/said-bendrioue.jpg';

type Props = { content: Content };
const { content } = Astro.props;
---

<section class="hero" aria-label="Hero">
  <div class="hero__media">
    <Image
      src={portrait}
      alt={content.hero.photoAlt}
      widths={[720, 1080, 1600, 2200]}
      sizes="100vw"
      quality={82}
      class="hero__img"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__ticks" aria-hidden="true"></div>
  </div>

  <div class="hero__content hero__anim">
    <h1 class="hero__brand" translate="no">{content.hero.brand}</h1>
    <p class="hero__role">{content.hero.role}</p>
    <p class="hero__headline">{content.hero.headline}</p>
    <p class="hero__lead">{content.hero.lead}</p>
    <div class="hero__cta">
      <a class="btn btn--primary" href={localizeHref(content.locale, '#contact')}>{content.hero.ctaPrimary}</a>
      <a class="btn btn--ghost" href={withBase('cv-said-bendrioue.pdf')} download>{content.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: grid;
    align-items: end;
    color: var(--white);
    overflow: clip;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        108deg,
        oklch(28% 0.055 250 / 0.92) 0%,
        oklch(28% 0.055 250 / 0.58) 40%,
        oklch(28% 0.055 250 / 0.2) 100%
      ),
      linear-gradient(
        180deg,
        oklch(28% 0.055 250 / 0.4) 0%,
        oklch(28% 0.055 250 / 0.1) 36%,
        oklch(28% 0.055 250 / 0.9) 100%
      );
  }

  .hero__ticks {
    position: absolute;
    left: max(1.25rem, calc((100% - var(--max)) / 2));
    bottom: 4.5rem;
    top: 35%;
    width: 2px;
    background: linear-gradient(180deg, transparent, oklch(100% 0 0 / 0.35));
    opacity: 0.7;
  }

  .hero__ticks::before,
  .hero__ticks::after {
    content: '';
    position: absolute;
    left: 0;
    width: 12px;
    height: 1px;
    background: oklch(100% 0 0 / 0.55);
  }

  .hero__ticks::before {
    top: 18%;
  }

  .hero__ticks::after {
    top: 62%;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: min(100% - 2.5rem, 42rem);
    margin-left: max(1.25rem, calc((100% - var(--max)) / 2));
    margin-right: auto;
    padding: 7.5rem 0 4.75rem;
  }

  @media (min-width: 860px) {
    .hero__content {
      padding-left: 1.85rem;
    }
  }

  .hero__brand {
    font-family: var(--font-display);
    font-size: clamp(2.9rem, 10vw, 5.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.96;
    margin-bottom: 0.85rem;
    color: var(--white);
  }

  .hero__role {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: oklch(100% 0 0 / 0.72);
    margin-bottom: 1.15rem;
  }

  .hero__headline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.22;
    max-width: 20ch;
    margin-bottom: 0.9rem;
    color: oklch(100% 0 0 / 0.96);
  }

  .hero__lead {
    max-width: 58ch;
    color: oklch(100% 0 0 / 0.8);
    font-size: 1.0625rem;
    line-height: 1.5;
    margin-bottom: 1.9rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .hero__anim {
    opacity: 0;
    transform: translateY(12px);
    animation: heroIn 0.48s var(--ease) 40ms forwards;
  }

  @keyframes heroIn {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .hero__content {
      padding-top: 6.5rem;
      padding-bottom: 3.25rem;
    }

    .hero__img {
      object-position: center 12%;
    }

    .hero__ticks {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__anim {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
