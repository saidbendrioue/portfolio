---
import type { Content } from '../i18n/content';

type Props = { content: Content };
const { content } = Astro.props;
---

<section id="about" class="section section--alt about">
  <div class="wrap about__grid">
    <div class="reveal">
      <p class="section__eyebrow">01</p>
      <h2 class="section__title">{content.about.title}</h2>
      <p class="about__loc">{content.about.location}</p>
    </div>
    <div class="about__body reveal">
      {content.about.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: 1.75rem 3.5rem;
  }

  .about__loc {
    color: var(--accent);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .about__body {
    display: grid;
    gap: 1.1rem;
    color: var(--ink-secondary);
    font-size: 1.125rem;
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  @media (min-width: 860px) {
    .about__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
    }
  }
</style>
