---
import type { Content } from '../i18n/content';

type Props = { content: Content };
const { content } = Astro.props;
---

<section id="about" class="section section--alt about">
  <div class="wrap about__grid">
    <div class="reveal">
      <h2 class="section__title">{content.about.title}</h2>
      <p class="about__loc">{content.about.location}</p>
    </div>
    <div class="about__body reveal">
      {content.about.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: 1.5rem 3.5rem;
  }

  .about__loc {
    color: var(--accent);
    font-size: 0.9375rem;
    font-weight: 560;
  }

  .about__body {
    display: grid;
    gap: 1rem;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  @media (min-width: 860px) {
    .about__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: start;
    }
  }
</style>
