---
import type { Content } from '../i18n/content';

type Props = { content: Content };
const { content } = Astro.props;
---

<section id="about" class="section section--alt about">
  <div class="wrap about__grid">
    <div class="reveal about__intro">
      <h2 class="section__title">{content.about.title}</h2>
      <p class="about__loc">{content.about.location}</p>
    </div>
    <div class="about__body reveal">
      {content.about.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: 1.75rem 4rem;
  }

  .about__loc {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .about__body {
    display: grid;
    gap: 1.1rem;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.58;
    max-width: 60ch;
  }

  @media (min-width: 860px) {
    .about__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
    }

    .about__intro {
      position: sticky;
      top: calc(var(--chrome-h) + 1.25rem);
    }
  }
</style>
