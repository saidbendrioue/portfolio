---
import type { Content } from '../i18n/content';
import { withBase } from '../i18n/content';

type Props = { content: Content };
const { content } = Astro.props;

const email = 'bendrioue@gmail.com';
const linkedin = 'https://www.linkedin.com/in/Said-Bendrioue';
---

<section id="contact" class="section contact">
  <div class="wrap contact__panel reveal">
    <div>
      <h2 class="section__title">{content.contact.title}</h2>
      <p class="section__lead">{content.contact.lead}</p>
    </div>

    <div class="contact__actions">
      <a class="contact__link contact__link--email" href={`mailto:${email}`}>
        <span>{content.contact.emailLabel}</span>
        <strong translate="no">{email}</strong>
      </a>
      <a class="contact__link" href={linkedin} target="_blank" rel="noopener noreferrer">
        <span>{content.contact.linkedinLabel}</span>
        <strong translate="no">in/Said-Bendrioue</strong>
      </a>
      <a class="btn btn--primary" href={withBase('cv-said-bendrioue.pdf')} download>
        {content.contact.cvLabel}
      </a>
      <p class="contact__note">{content.contact.cvNote}</p>
    </div>
  </div>
</section>

<style>
  .contact__panel {
    display: grid;
    gap: 2.25rem;
    padding: 0.25rem 0 0.5rem;
  }

  .contact__actions {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .contact__link {
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
    padding-bottom: 0.95rem;
    border-bottom: var(--hairline);
    cursor: pointer;
  }

  .contact__link:hover {
    color: inherit;
  }

  .contact__link:hover strong {
    color: var(--link);
  }

  .contact__link span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .contact__link strong {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .contact__link--email strong {
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
  }

  .contact__note {
    color: var(--muted);
    font-size: 0.875rem;
  }

  @media (min-width: 860px) {
    .contact__panel {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3.25rem;
      align-items: end;
    }
  }
</style>
