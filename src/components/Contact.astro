---
import type { Content } from '../i18n/content';
import { withBase } from '../i18n/content';

type Props = { content: Content };
const { content } = Astro.props;

const email = 'bendrioue@gmail.com';
const linkedin = 'https://www.linkedin.com/in/Said-Bendrioue';
---

<section id="contact" class="section contact">
  <div class="wrap contact__panel reveal">
    <div>
      <p class="section__eyebrow">04</p>
      <h2 class="section__title">{content.contact.title}</h2>
      <p class="section__lead">{content.contact.lead}</p>
    </div>

    <div class="contact__actions">
      <a class="contact__link" href={`mailto:${email}`}>
        <span>{content.contact.emailLabel}</span>
        <strong>{email}</strong>
      </a>
      <a class="contact__link" href={linkedin} target="_blank" rel="noopener noreferrer">
        <span>{content.contact.linkedinLabel}</span>
        <strong>in/Said-Bendrioue</strong>
      </a>
      <a class="btn btn--outline" href={withBase('cv-said-bendrioue.pdf')} download>
        {content.contact.cvLabel}
      </a>
      <p class="contact__note">{content.contact.cvNote}</p>
    </div>
  </div>
</section>

<style>
  .contact__panel {
    display: grid;
    gap: 2.25rem;
    padding: 0.5rem 0 1rem;
  }

  .contact__actions {
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  .contact__link {
    display: grid;
    gap: 0.2rem;
    text-decoration: none;
    padding: 0.95rem 1rem;
    border-radius: 1rem;
    background: var(--surface);
    box-shadow:
      0 0.5px 0 rgba(255, 255, 255, 0.7) inset,
      0 6px 20px rgba(0, 0, 0, 0.04);
    transition:
      transform var(--press),
      box-shadow 0.25s var(--spring);
  }

  .contact__link:hover {
    color: inherit;
  }

  .contact__link:active {
    transform: scale(0.985);
  }

  .contact__link span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .contact__link strong {
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .contact__note {
    color: var(--ink-secondary);
    font-size: 0.875rem;
    letter-spacing: 0.01em;
  }

  @media (min-width: 860px) {
    .contact__panel {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3rem;
      align-items: end;
    }
  }
</style>
