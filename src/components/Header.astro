---
import type { Content } from '../i18n/content';
import { withBase, localizeHref } from '../i18n/content';

type Props = { content: Content };
const { content } = Astro.props;
const otherHref = withBase(content.otherLocaleHref.replace(/^\//, ''));
---

<header class="chrome" data-chrome>
  <div class="wrap chrome__inner">
    <a class="chrome__brand" href={localizeHref(content.locale, '')}>{content.hero.brand}</a>
    <nav class="chrome__nav" aria-label="Primary">
      <a href={localizeHref(content.locale, '#about')}>{content.nav.about}</a>
      <a href={localizeHref(content.locale, '#projects')}>{content.nav.projects}</a>
      <a href={localizeHref(content.locale, '#skills')}>{content.nav.skills}</a>
      <a href={localizeHref(content.locale, '#contact')}>{content.nav.contact}</a>
      <a class="chrome__cv" href={withBase('cv-said-bendrioue.pdf')} download>{content.nav.cv}</a>
      <a
        class="chrome__lang"
        href={otherHref}
        hreflang={content.otherLocale}
        lang={content.otherLocale}
      >
        {content.otherLocaleLabel}
      </a>
    </nav>
  </div>
</header>

<script>
  const chrome = document.querySelector('[data-chrome]');
  if (chrome) {
    const sync = () => {
      const pastHero = window.scrollY > Math.min(window.innerHeight * 0.7, 520);
      chrome.classList.toggle('is-solid', pastHero);
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
  }
</script>

<style>
  .chrome {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    /* Solid ink bar — no glass */
    background: var(--ink);
    border-bottom: 1px solid transparent;
    transition:
      background 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .chrome.is-solid {
    background: var(--paper);
    border-bottom-color: var(--line);
  }

  .chrome__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.35rem;
  }

  .chrome__brand {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--white);
    text-decoration: none;
  }

  .chrome.is-solid .chrome__brand {
    color: var(--ink);
  }

  .chrome__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.15rem 0.35rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .chrome__nav a {
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius);
  }

  .chrome__nav a:hover {
    color: var(--white);
  }

  .chrome.is-solid .chrome__nav a {
    color: var(--ink);
  }

  .chrome.is-solid .chrome__nav a:hover {
    color: var(--accent);
  }

  .chrome__lang {
    border: 1px solid rgba(255, 255, 255, 0.35);
    margin-left: 0.25rem;
    font-weight: 600;
  }

  .chrome.is-solid .chrome__lang {
    border-color: var(--line);
  }

  .chrome__cv {
    display: none;
  }

  @media (min-width: 860px) {
    .chrome__cv {
      display: inline;
    }
  }

  @media (max-width: 720px) {
    .chrome__nav a:not(.chrome__lang) {
      display: none;
    }
  }
</style>
