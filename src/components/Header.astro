---
import type { Content } from '../i18n/content';
import { withBase, localizeHref } from '../i18n/content';

type Props = { content: Content };
const { content } = Astro.props;
const otherHref = withBase(content.otherLocaleHref.replace(/^\//, ''));
---

<header class="chrome" data-chrome>
  <div class="wrap chrome__inner">
    <a class="chrome__brand" href={localizeHref(content.locale, '')}>{content.hero.brand}</a>
    <nav class="chrome__nav" aria-label="Primary">
      <a href={localizeHref(content.locale, '#about')}>{content.nav.about}</a>
      <a href={localizeHref(content.locale, '#projects')}>{content.nav.projects}</a>
      <a href={localizeHref(content.locale, '#skills')}>{content.nav.skills}</a>
      <a href={localizeHref(content.locale, '#contact')}>{content.nav.contact}</a>
      <a class="chrome__cv" href={withBase('cv-said-bendrioue.pdf')} download>{content.nav.cv}</a>
      <a
        class="chrome__lang"
        href={otherHref}
        hreflang={content.otherLocale}
        lang={content.otherLocale}
      >
        {content.otherLocaleLabel}
      </a>
    </nav>
  </div>
  <!-- Scroll-edge material instead of a hard divider (apple-design §12) -->
  <div class="chrome__edge" aria-hidden="true"></div>
</header>

<script>
  const chrome = document.querySelector('[data-chrome]');
  if (chrome) {
    const sync = () => {
      const pastHero = window.scrollY > Math.min(window.innerHeight * 0.72, 560);
      chrome.classList.toggle('is-solid', pastHero);
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
  }
</script>

<style>
  .chrome {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    /* Translucent material — content scrolls underneath */
    background: rgba(10, 20, 36, 0.42);
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    transition:
      background 0.35s var(--spring),
      color 0.35s var(--spring),
      box-shadow 0.35s var(--spring);
  }

  .chrome.is-solid {
    background: rgba(245, 245, 247, 0.72);
    box-shadow: 0 0.5px 0 rgba(0, 0, 0, 0.06);
  }

  .chrome__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    padding-block: 0.55rem;
  }

  .chrome__brand {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--white);
    text-decoration: none;
    transition: color 0.3s var(--spring), transform var(--press);
  }

  .chrome__brand:active {
    transform: scale(0.97);
  }

  .chrome.is-solid .chrome__brand {
    color: var(--ink);
  }

  .chrome__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.15rem 0.15rem;
    font-size: 0.8125rem;
    font-weight: 510;
    letter-spacing: -0.01em;
  }

  .chrome__nav a {
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
    padding: 0.4rem 0.65rem;
    border-radius: 980px;
    transition:
      background-color var(--press),
      color 0.25s var(--spring),
      transform var(--press);
  }

  .chrome__nav a:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--white);
  }

  .chrome__nav a:active {
    transform: scale(0.97);
  }

  .chrome.is-solid .chrome__nav a {
    color: var(--ink);
  }

  .chrome.is-solid .chrome__nav a:hover {
    background: rgba(0, 0, 0, 0.05);
    color: var(--ink);
  }

  .chrome__lang {
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .chrome.is-solid .chrome__lang {
    background: rgba(0, 0, 0, 0.06);
  }

  .chrome__cv {
    display: none;
  }

  .chrome__edge {
    pointer-events: none;
    height: 12px;
    margin-bottom: -12px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.06), transparent);
    opacity: 0;
    transition: opacity 0.3s var(--spring);
  }

  .chrome.is-solid .chrome__edge {
    opacity: 1;
  }

  @media (min-width: 860px) {
    .chrome__cv {
      display: inline;
    }
  }

  @media (max-width: 720px) {
    .chrome__nav a:not(.chrome__lang) {
      display: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .chrome {
      background: rgba(10, 20, 36, 0.94);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .chrome.is-solid {
      background: #f5f5f7;
    }
  }

  @media (prefers-contrast: more) {
    .chrome,
    .chrome.is-solid {
      background: #ffffff;
      border-bottom: 2px solid #000;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .chrome__brand,
    .chrome__nav a,
    .chrome.is-solid .chrome__brand,
    .chrome.is-solid .chrome__nav a {
      color: #000;
    }
  }
</style>
