---
import type { Content } from '../i18n/content';
import { withBase, localizeHref } from '../i18n/content';

type Props = { content: Content };
const { content } = Astro.props;
const otherHref = withBase(content.otherLocaleHref.replace(/^\//, ''));
---

<header class="chrome" data-chrome>
  <div class="wrap chrome__inner">
    <a class="chrome__brand" href={localizeHref(content.locale, '')}>
      <span class="chrome__seal" aria-hidden="true">SB</span>
      <span translate="no">{content.hero.brand}</span>
    </a>
    <nav class="chrome__nav" aria-label="Primary">
      <a href={localizeHref(content.locale, '#about')}>{content.nav.about}</a>
      <a href={localizeHref(content.locale, '#projects')}>{content.nav.projects}</a>
      <a href={localizeHref(content.locale, '#skills')}>{content.nav.skills}</a>
      <a href={localizeHref(content.locale, '#contact')}>{content.nav.contact}</a>
      <a class="chrome__cv" href={withBase('cv-said-bendrioue.pdf')} download>{content.nav.cv}</a>
      <a
        class="chrome__lang"
        href={otherHref}
        hreflang={content.otherLocale}
        lang={content.otherLocale}
      >
        {content.otherLocaleLabel}
      </a>
    </nav>
  </div>
</header>

<script>
  const chrome = document.querySelector('[data-chrome]');
  if (chrome) {
    const sync = () => {
      const pastHero = window.scrollY > Math.min(window.innerHeight * 0.68, 500);
      chrome.classList.toggle('is-solid', pastHero);
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
  }
</script>

<style>
  .chrome {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    background: var(--ink);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.28s var(--ease),
      border-color 0.28s var(--ease);
  }

  .chrome.is-solid {
    background: color-mix(in oklab, var(--paper) 92%, var(--surface));
    border-bottom-color: var(--line);
  }

  .chrome__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--chrome-h);
  }

  .chrome__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--white);
    text-decoration: none;
  }

  .chrome__seal {
    display: inline-grid;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    border: 1px solid oklch(100% 0 0 / 0.45);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .chrome.is-solid .chrome__brand {
    color: var(--ink);
  }

  .chrome.is-solid .chrome__seal {
    border-color: var(--ink);
    color: var(--ink);
  }

  .chrome__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.1rem 0.2rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .chrome__nav a {
    position: relative;
    color: oklch(100% 0 0 / 0.88);
    text-decoration: none;
    padding: 0.4rem 0.55rem;
    border-radius: var(--radius);
    min-height: 2.5rem;
    display: inline-flex;
    align-items: center;
  }

  .chrome__nav a:not(.chrome__lang)::after {
    content: '';
    position: absolute;
    left: 0.55rem;
    right: 0.55rem;
    bottom: 0.35rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.22s var(--ease);
  }

  .chrome__nav a:not(.chrome__lang):hover::after {
    transform: scaleX(1);
  }

  .chrome__nav a:hover {
    color: var(--white);
  }

  .chrome.is-solid .chrome__nav a {
    color: var(--ink);
  }

  .chrome.is-solid .chrome__nav a:hover {
    color: var(--accent);
  }

  .chrome__lang {
    border: 1px solid oklch(100% 0 0 / 0.35);
    margin-left: 0.35rem;
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .chrome.is-solid .chrome__lang {
    border-color: var(--line);
  }

  .chrome__cv {
    display: none;
  }

  @media (min-width: 860px) {
    .chrome__cv {
      display: inline-flex;
    }
  }

  @media (max-width: 720px) {
    .chrome__nav a:not(.chrome__lang) {
      display: none;
    }

    .chrome__brand span:not(.chrome__seal) {
      max-width: 11rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
