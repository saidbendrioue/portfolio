---
import { techIcons, type TechIconKey } from '../data/tech-icons';

type Props = {
  name: TechIconKey;
  size?: number;
  class?: string;
};

const { name, size = 22, class: className } = Astro.props;
const icon = techIcons[name];
const viewBox = icon.viewBox ?? '0 0 24 24';
---

<span
  class:list={['tech-icon', className]}
  style={`--tech-brand: ${icon.brand}`}
  title={icon.label}
>
  <svg
    width={size}
    height={size}
    viewBox={viewBox}
    aria-hidden="true"
    focusable="false"
  >
    <path fill="currentColor" d={icon.path} />
  </svg>
  <span class="sr-only">{icon.label}</span>
</span>

<style>
  .tech-icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--ink);
    background: color-mix(in srgb, var(--color-primary) 4%, transparent);
    border: 1px solid var(--color-border);
    flex-shrink: 0;
    transition:
      color 200ms var(--ease),
      background-color 200ms var(--ease),
      border-color 200ms var(--ease);
  }

  .tech-icon svg {
    display: block;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
